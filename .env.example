# LinkedIn (get li_at cookie from browser DevTools > Application > Cookies)
# LINKEDIN_COOKIE=your_li_at_cookie_value

# Hunter.io API key (optional, free tier = 25 lookups/month)
# HUNTER_API_KEY=your_hunter_api_key

# Proxy support (optional, pick one)
# OPENSCRAPPER_PROXY=http://user:pass@host:port
# OPENSCRAPPER_PROXY_FILE=proxies.txt
# OPENSCRAPPER_FREE_PROXY=true

# Fetch engine: auto (default, escalates http -> stealth browser -> playwright), http, stealth, browser, legacy
# OPENSCRAPPER_ENGINE=auto

# AI extraction (optional, powers Smart Scrape + enrichment fallback). Pick one:
# OPENSCRAPPER_LLM=ollama/llama3.2
# OPENSCRAPPER_LLM=openai/gpt-4o-mini
# OPENSCRAPPER_LLM=anthropic/claude-haiku-5-5
# OPENSCRAPPER_LLM_KEY=your_api_key        (hosted providers only)
# OPENSCRAPPER_LLM_URL=http://localhost:11434   (optional base URL)

# Where learned selectors and scraper-health stats are stored (default ~/.openscrapper)
# OPENSCRAPPER_HOME=/path/to/dir

# Old SCOUT_* names still work; OPENSCRAPPER_* wins if both are set.

# Politeness: minimum seconds between requests to the same host (default 0.3)
# OPENSCRAPPER_HOST_DELAY=0.3
# Retries with exponential backoff on HTTP 429/5xx before trying the next fetch tier (default 2)
# OPENSCRAPPER_RETRIES=2
